# VITE_SUPABASE_URL: URL do projeto Supabase (Project Settings → API → Project URL).
# Pública — vai para o bundle do frontend (Vite exige o prefixo VITE_ para isso).
VITE_SUPABASE_URL=

# VITE_SUPABASE_ANON_KEY: chave anônima/pública do Supabase (Project Settings →
# API → anon / public key). Pública por design — a segurança dos dados vem do
# Row Level Security configurado no banco, não do sigilo desta chave.
VITE_SUPABASE_ANON_KEY=

# SUPABASE_SERVICE_ROLE_KEY: chave secreta do Supabase (Project Settings → API
# → service_role key). NUNCA prefixe com VITE_ ou exponha ao navegador — é
# usada só dentro das rotas /api (funções serverless da Vercel) para ações
# administrativas (criar/remover membro da equipe, redefinir senha de outra
# pessoa), que ignoram as permissões normais do usuário logado.
SUPABASE_SERVICE_ROLE_KEY=
