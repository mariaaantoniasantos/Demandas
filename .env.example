# PORT: Porta em que o servidor Express (API + frontend) é servido.
PORT=3000

# JWT_SECRET: Chave secreta usada para assinar os tokens de sessão (login).
# Defina um valor forte e único em produção.
JWT_SECRET="troque-esta-chave-em-producao"

# DATA_DIR (opcional): pasta onde o arquivo server/data/users.json é gravado.
# Deixe em branco para uso local (usa a pasta server/data do próprio projeto).
# Em produção com disco persistente (ex: Render), aponte para o mount path
# do disco, ex: DATA_DIR=/var/data — veja DEPLOY.md.
DATA_DIR=
